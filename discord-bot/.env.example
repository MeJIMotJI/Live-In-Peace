# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ (.env ห้าม commit ขึ้น git)
# ไฟล์นี้ใช้กับ 2 อย่างเท่านั้น: (1) `npm run deploy-commands` ที่รันในเครื่อง
# และ (2) `wrangler dev` ตอนทดสอบในเครื่อง — ค่าจริงบน Cloudflare ต้องตั้งแยกด้วย
# `wrangler secret put` (ดูวิธีใน README.md หัวข้อ "Deploy ขึ้น Cloudflare Workers")

# จาก https://discord.com/developers/applications -> แอปของคุณ -> Bot -> Reset Token
DISCORD_TOKEN=

# จาก https://discord.com/developers/applications -> แอปของคุณ -> General Information -> Application ID
CLIENT_ID=

# เหมือนกับ CLIENT_ID ด้านบนทุกตัวอักษร (worker.js เรียกใช้ชื่อนี้)
DISCORD_APPLICATION_ID=

# จาก https://discord.com/developers/applications -> แอปของคุณ -> General Information -> Public Key
# ใช้ตรวจสอบว่า request ที่เข้ามาเป็นของ Discord จริง ไม่ใช่ token/secret ที่ต้องปิดบัง แต่ก็ไม่ควร commit อยู่ดี
DISCORD_PUBLIC_KEY=

# (แนะนำระหว่างพัฒนา) ใส่ Server ID เพื่อให้ slash command อัปเดตทันที ไม่ต้องรอ 1 ชม.
# คลิกขวาที่ไอคอนเซิร์ฟเวอร์ใน Discord -> Copy Server ID (ต้องเปิด Developer Mode ก่อนใน User Settings)
GUILD_ID=

# ห้องที่จะให้บอทโพสต์ข้อพระคัมภีร์ + บทเฝ้าเดี่ยวประจำวันอัตโนมัติทุกวัน (คลิกขวาที่ห้อง -> Copy Channel ID)
# ถ้าไม่ใส่ค่านี้ บอทจะไม่โพสต์อัตโนมัติ แต่ยังใช้คำสั่ง /versetoday กับ /mana เองได้
DAILY_VERSE_CHANNEL_ID=

# (ไม่บังคับ) GitHub Personal Access Token เปล่าๆ (ไม่ต้องมีสิทธิ์พิเศษ) ใช้เพิ่ม rate limit
# ตอนบอทอ่านรายชื่อหนังสือ/บทจาก GitHub API จาก 60 เป็น 5000 ครั้ง/ชม. ถ้าไม่ใส่ก็ใช้งานได้ปกติ
GITHUB_TOKEN=
